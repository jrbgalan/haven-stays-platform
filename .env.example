# Unsplash API Access Key (Required for running `npm run fetch-photos` script)
# NEVER prefix with VITE_ and NEVER commit actual keys to version control.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# OpenAI API Key for AI features (AI Concierge, Smart Search, Listing Copywriter)
VITE_OPENAI_API_KEY=your_openai_api_key_here

